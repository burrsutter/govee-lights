# Govee Lights — environment template
# Copy to .env and fill in your values:  cp .env.example .env

# Govee LAN UDP API (port 4003 — requires LAN Control enabled in Govee app per device)
# Known devices: H6076 floor lamps, H61D5 neon ropes
# Option 1: comma-separated IPs in default order floor-lamp-1, floor-lamp-2, neon-rope-black, neon-rope-white
GOVEE_LIGHT_IPS=192.168.4.49,192.168.4.28,192.168.4.42,192.168.4.43
# Option 2: JSON map (overrides GOVEE_LIGHT_IPS if set)
# GOVEE_LIGHTS_JSON={"floor-lamp-1":"192.168.4.49","floor-lamp-2":"192.168.4.28","neon-rope-black":"192.168.4.42","neon-rope-white":"192.168.4.43"}
# Option 3: per-device overrides
# GOVEE_FLOOR_LAMP_1_IP=192.168.4.49
# GOVEE_NEON_ROPE_BLACK_IP=192.168.4.42
